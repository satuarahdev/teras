# ==============================================================================
# TERAS - High-Performance Telegram Bot API Gateway & Relay Wrapper (Rust)
# ==============================================================================

# Server Listening Port (Default: 3001)
PORT=3001

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_ExampleToken

# The Public Domain or Hostname where Teras is accessible (used for webhook registration)
DOMAIN=your-domain.com

# Target Webhook URL where incoming Telegram messages will be forwarded
# (Points to your backend logic service, e.g., Bantu Backend Rust / Python)
WEBHOOK_FORWARD_URL=https://your-backend-api.com/api/v1/webhook/telegram
